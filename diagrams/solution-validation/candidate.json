{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Solution Validation",
    "subtitle": "After the desired outcomes are validated. Abstract, applies to any project",
    "output": "diagrams/solution-validation/solution-validation.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "plan",
      "label": "Choose + plan"
    },
    {
      "id": "test",
      "label": "Build + learn"
    }
  ],
  "groups": [
    {
      "id": "g-choose",
      "label": "Choose the approach",
      "lane": "plan",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "outcomes",
    "list",
    "pick",
    "hypothesis",
    "how",
    "requirements",
    "build"
  ],
  "nodes": [
    {
      "id": "outcomes",
      "lane": "plan",
      "col": 0,
      "type": "external",
      "icon": "flag",
      "label": "Validated outcome",
      "sublabel": "what we proved in layer 1",
      "width": 158,
      "description": "The result of layer 1. Example: owners really want to save time, with evidence."
    },
    {
      "id": "list",
      "lane": "plan",
      "col": 1,
      "type": "frontend",
      "label": "Explore ways to achieve it",
      "sublabel": "from all evidence we have",
      "width": 180,
      "description": "List the possible ways to deliver the outcome. Draw on what you know about their processes, interview stories, social media and community research, and competitors."
    },
    {
      "id": "pick",
      "lane": "plan",
      "col": 2,
      "type": "frontend",
      "label": "Pick one way",
      "sublabel": "most evidence, cheapest test",
      "width": 158,
      "description": "Choose one way from the list. Prefer the one with the strongest evidence that you can test cheaply."
    },
    {
      "id": "hypothesis",
      "lane": "plan",
      "col": 3,
      "type": "backend",
      "label": "Hypotheses + bar",
      "sublabel": "number set before building",
      "width": 158,
      "description": "If we do this, the outcome improves from X to Y. Write the number before building, so the result cannot change the rules."
    },
    {
      "id": "how",
      "lane": "plan",
      "col": 4,
      "type": "backend",
      "label": "Choose how to validate",
      "sublabel": "cheapest honest test",
      "width": 158
    },
    {
      "id": "requirements",
      "lane": "plan",
      "col": 5,
      "type": "backend",
      "label": "Minimal requirements",
      "sublabel": "smallest version",
      "width": 158
    },
    {
      "id": "build",
      "lane": "test",
      "col": 5,
      "type": "backend",
      "label": "Build",
      "sublabel": "fast, with AI",
      "width": 158
    },
    {
      "id": "validate",
      "lane": "test",
      "col": 4,
      "type": "messagebus",
      "label": "Validate",
      "sublabel": "real users, real data",
      "width": 158
    },
    {
      "id": "document",
      "lane": "test",
      "col": 3,
      "type": "database",
      "label": "Document + decide",
      "sublabel": "keep, narrow, change, stop",
      "width": 158
    },
    {
      "id": "share",
      "lane": "test",
      "col": 2,
      "type": "cloud",
      "label": "Share",
      "sublabel": "X post, portfolio case",
      "width": 158
    },
    {
      "id": "next",
      "lane": "test",
      "col": 1,
      "type": "security",
      "icon": "decision",
      "label": "Next lap or layer",
      "sublabel": "repeat or go deeper",
      "width": 158
    }
  ],
  "edges": [
    {
      "id": "e-outcomes-list",
      "from": "outcomes",
      "to": "list"
    },
    {
      "id": "e-list-pick",
      "from": "list",
      "to": "pick",
      "variant": "emphasis"
    },
    {
      "id": "e-pick-hypothesis",
      "from": "pick",
      "to": "hypothesis"
    },
    {
      "id": "e-hypothesis-how",
      "from": "hypothesis",
      "to": "how"
    },
    {
      "id": "e-how-requirements",
      "from": "how",
      "to": "requirements"
    },
    {
      "id": "e-requirements-build",
      "from": "requirements",
      "to": "build",
      "variant": "emphasis"
    },
    {
      "id": "e-build-validate",
      "from": "build",
      "to": "validate",
      "role": "branch"
    },
    {
      "id": "e-validate-document",
      "from": "validate",
      "to": "document",
      "role": "branch",
      "variant": "emphasis"
    },
    {
      "id": "e-document-share",
      "from": "document",
      "to": "share",
      "role": "branch"
    },
    {
      "id": "e-share-next",
      "from": "share",
      "to": "next",
      "role": "branch"
    },
    {
      "id": "e-next-list",
      "from": "next",
      "to": "list",
      "label": "next lap",
      "variant": "dashed",
      "role": "return"
    }
  ]
}
