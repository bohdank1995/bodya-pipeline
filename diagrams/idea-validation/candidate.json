{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Validation Pipeline",
    "subtitle": "Validates the high-level problems behind the vision and target audience, to prove that the direction is relevant and that people are willing to pay for it.",
    "output": "diagrams/idea-validation/idea-validation.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "visible": false
        },
        "database": {
          "visible": false
        },
        "security": {
          "label": "You decide"
        },
        "messagebus": {
          "visible": false
        },
        "external": {
          "visible": false
        }
      }
    }
  },
  "lanes": [
    {
      "id": "foundation",
      "label": "Foundation"
    },
    {
      "id": "validation",
      "label": "Validation"
    },
    {
      "id": "result",
      "label": "After validating"
    }
  ],
  "mainPath": [
    "vision",
    "audience",
    "outcomes",
    "choose",
    "formulate",
    "how",
    "validate"
  ],
  "nodes": [
    {
      "id": "vision",
      "lane": "foundation",
      "col": 0,
      "type": "external",
      "icon": "flag",
      "label": "Vision",
      "sublabel": "where we want to get to",
      "width": 158,
      "description": "The change you want to create, in one or two sentences. It is a direction you choose, not a proven fact, so it stays a starting assumption until evidence supports it."
    },
    {
      "id": "audience",
      "lane": "foundation",
      "col": 1,
      "type": "external",
      "icon": "person",
      "label": "Target audience",
      "sublabel": "who we build it for",
      "width": 158,
      "description": "The specific group of people the vision is for: who they are, which segment first, and who qualifies. A starting assumption that the evidence will keep, narrow or change."
    },
    {
      "id": "outcomes",
      "lane": "foundation",
      "col": 2,
      "type": "frontend",
      "icon": "start",
      "label": "Desired outcomes",
      "sublabel": "what they want",
      "width": 158
    },
    {
      "id": "choose",
      "lane": "validation",
      "col": 2,
      "type": "security",
      "label": "Choose what to validate",
      "sublabel": "one outcome or claim",
      "width": 158,
      "tag": "step 1",
      "icon": "decision"
    },
    {
      "id": "formulate",
      "lane": "validation",
      "col": 3,
      "type": "security",
      "label": "Hypotheses + bar",
      "sublabel": "number set before testing",
      "width": 158,
      "tag": "step 2",
      "icon": "decision"
    },
    {
      "id": "how",
      "lane": "validation",
      "col": 4,
      "type": "security",
      "label": "Choose how to validate",
      "sublabel": "cheapest honest test",
      "width": 158,
      "tag": "step 3",
      "icon": "decision"
    },
    {
      "id": "validate",
      "lane": "validation",
      "col": 5,
      "type": "messagebus",
      "label": "Validate",
      "sublabel": "profile, then calls",
      "width": 158,
      "tag": "step 4",
      "description": "Starts with the validation profile: who, how many, which methods and what counts. Then you talk to the people in the profile."
    },
    {
      "id": "evidence",
      "lane": "result",
      "col": 5,
      "type": "database",
      "label": "Evidence log",
      "sublabel": "one row per evidence",
      "tag": "step 4",
      "width": 158,
      "description": "While validating, write down what each person said or showed: one row per piece of evidence, with exact words, the hypothesis, for or against, and whether it was unprompted."
    },
    {
      "id": "result",
      "lane": "result",
      "col": 4,
      "type": "security",
      "icon": "decision",
      "label": "Result + decision",
      "sublabel": "count, verdict, decide",
      "tag": "step 5",
      "width": 158,
      "description": "Count the people for and against each hypothesis, compare with its success bar, apply the verdict rule, then decide: keep, narrow, change or stop."
    },
    {
      "id": "gate",
      "lane": "result",
      "col": 3,
      "type": "security",
      "icon": "decision",
      "label": "Gate",
      "sublabel": "all checks pass?",
      "width": 158,
      "description": "Checks the previous steps before a solution can start: the bars were not moved, the sample was reached, the audience was right, the verdict rule is met, the evidence against was read, and the decision is keep. Not yet means more evidence. Fail means a new lap."
    },
    {
      "id": "validated",
      "lane": "result",
      "col": 2,
      "type": "external",
      "icon": "flag",
      "label": "Validated outcome",
      "sublabel": "start of layer 2",
      "width": 158,
      "description": "Written only when the gate passes: the outcome, its strongest evidence, the strongest evidence against, and what is still unknown. Solution validation starts from here."
    }
  ],
  "edges": [
    {
      "id": "e-vision-audience",
      "from": "vision",
      "to": "audience",
