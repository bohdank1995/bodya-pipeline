    },
    {
      "id": "e-choose-formulate",
      "from": "choose",
      "to": "formulate"
    },
    {
      "id": "e-formulate-how",
      "from": "formulate",
      "to": "how"
    },
    {
      "id": "e-how-validate",
      "from": "how",
      "to": "validate",
      "variant": "emphasis"
    },
    {
      "id": "e-validate-evidence",
      "from": "validate",
      "to": "evidence",
      "role": "branch"
    },
    {
      "id": "e-evidence-result",
      "from": "evidence",
      "to": "result",
      "role": "branch"
    },
    {
      "id": "e-result-gate",
      "from": "result",
      "to": "gate",
      "role": "branch",
      "variant": "emphasis"
    },
    {
      "id": "e-gate-validated",
      "from": "gate",
      "to": "validated",
      "label": "pass",
      "role": "branch",
      "variant": "emphasis"
    },
    {
      "id": "e-gate-choose",
      "from": "gate",
      "to": "choose",
      "label": "next lap",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "groups": [
    {
      "id": "g-start",
      "label": "Starting assumptions",
      "lane": "foundation",
      "fromCol": 0,
      "toCol": 1,
      "variant": "emphasis"
    }
  ]
}
